{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobdisco portable autofill memory",
  "description": "Private confirmed profile, update history and pending observations. Unknown properties are preserved in import archives.",
  "type": "object",
  "required": ["format", "schema_version", "exported_at", "profile", "pending_captures"],
  "properties": {
    "format": {"const": "jobdisco-autofill-memory"},
    "schema_version": {"const": 1},
    "exported_at": {"type": "string", "format": "date-time"},
    "pending_captures": {"type": "object", "description": "Unconfirmed observations; never implicitly promoted to global facts."},
    "profile": {
      "type": "object",
      "required": ["version", "fields", "questions"],
      "properties": {
        "version": {"const": 1},
        "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field"}},
        "questions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/question"}},
        "education": {"type": "array", "items": {"type": "object"}},
        "employment": {"type": "array", "items": {"type": "object"}},
        "extensions": {"type": "object"},
        "preferences": {"type": "object"},
        "position_contexts": {"type": "object"},
        "memory": {
          "type": "object", "required": ["revision", "history", "conflicts"],
          "properties": {
            "revision": {"type": "integer", "minimum": 0},
            "history": {"type": "array", "items": {"type": "object"}},
            "conflicts": {"type": "array", "items": {"type": "object"}},
            "imports": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object", "required": ["label", "type", "policy"],
      "properties": {
        "label": {"type": "string"},
        "type": {"enum": ["text", "integer", "boolean", "choice", "multi_choice"]},
        "policy": {"enum": ["fill", "review"]},
        "answer": {"type": ["string", "integer", "boolean", "array", "null"], "items": {"type": "string"}},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "context_answers": {"type": "object"},
        "reuse_scope": {"enum": ["global", "site", "position"]},
        "source_site": {"type": "string"},
        "source_position_id": {"type": ["string", "null"]},
        "updated_at": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"type": {"enum": ["text", "choice"]}}}, "then": {"properties": {"answer": {"type": ["string", "null"]}}}},
        {"if": {"properties": {"type": {"const": "integer"}}}, "then": {"properties": {"answer": {"type": ["integer", "null"]}}}},
        {"if": {"properties": {"type": {"const": "boolean"}}}, "then": {"properties": {"answer": {"type": ["boolean", "null"]}}}},
        {"if": {"properties": {"type": {"const": "multi_choice"}}}, "then": {"properties": {"answer": {"type": ["array", "null"], "items": {"type": "string"}}}}}
      ]
    },
    "question": {
      "type": "object", "required": ["label", "site", "kind", "options"],
      "properties": {
        "label": {"type": "string"},
        "site": {"type": "string", "pattern": "^https://"},
        "kind": {"enum": ["text", "number", "select", "radio", "multiselect", "checkbox"]},
        "options": {"type": "array", "items": {"type": "string"}},
        "section": {"type": "string"},
        "field_key": {"type": ["string", "null"]},
        "required_position_id": {"type": ["string", "null"]}
      }
    }
  }
}
