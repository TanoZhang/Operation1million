# Local runtime and credentials
.venv/
.agents/
__pycache__/
*.pyc
*.egg-info/
.env
.env.*
!.env.example
.openai_api_key
.claude/settings.local.json

# Persistent local quota ledger
.local/
/application-autofill/extension/local-profile.json

# Generated discovery runs. latest.json used to be excepted, and it was a
# pointer to a run directory that this ignore rule keeps out of the repository:
# it named 20260915T190602Z, which exists in no checkout, and the only function
# that reads it is called by nothing. A pointer into a cache is cache.
/runs/

# Output of `job-validate-sources`, which regenerates it by re-running the
# probes. Committing a report means every re-run shows as a change to review.
/data/raw/

# Derived database. Rebuilt in ~2s by `job-store --bootstrap` from schema.sql,
# migrations and the committed run log, so no binary belongs in Git.
# Everything derived, not just the three suffixes a rebuild happens to write.
# A hand-made copy taken before a risky change -- job_discovery.sqlite.bak --
# matched none of them, landed inside the checkout, and made the tree dirty on a
# machine whose installer wants it clean.
/data/db/*

# Collected data lives in the private companion repository, reached through
# JOBDISCO_STORE. This path is only the default for a single-machine setup.
/data/store/
