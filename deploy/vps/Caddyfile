# Review over HTTPS for a phone (2026-10-11), and Obsidian's notes under
# /notes/ (2026-10-19), on one name. sslip.io resolves it to the VPS at no
# cost, and Caddy obtains and renews the certificate.
#
# Review has no login of its own and hands its write token to whoever can
# load the page, so every request is first asked of /__auth: a signed cookie
# from the password-only page at /__login (review_login.py). Without the
# password record nobody gets past it. The SSH tunnel reaches port 8765
# directly and is not asked.
40-160-142-175.sslip.io {
	# Read by fail2ban: WebDAV logins that fail (deploy/vps/fail2ban).
	log {
		output file /var/log/caddy/access.log
		format json
	}
	# /notes/, installed by notes-password.sh once its own login exists.
	# A pattern that matches nothing imports nothing.
	import /etc/caddy/routes/*.caddy
	handle /__login {
		reverse_proxy 127.0.0.1:8765 {
			# The review server answers only a local Host, as through the tunnel.
			header_up Host localhost:8765
		}
	}
	handle {
		forward_auth 127.0.0.1:8765 {
			uri /__auth
			header_up Host localhost:8765
		}
		reverse_proxy 127.0.0.1:8765 {
			header_up Host localhost:8765
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}
}
