# Obsidian notes over WebDAV, for Remotely Save (the user, 2026-10-19): the
# address https://40-160-142-175.sslip.io/notes/ with its own login. rclone
# serves one folder on loopback; this adds the login. Installed into
# /etc/caddy/routes/ by notes-password.sh, after the login file exists.
@notes path /notes /notes/*
handle @notes {
	basic_auth {
		import /etc/caddy/notes-users
	}
	reverse_proxy 127.0.0.1:8780
}
