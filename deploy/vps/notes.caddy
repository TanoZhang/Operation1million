# Obsidian notes over WebDAV, for Remotely Save (the user, 2026-10-19).
#
# rclone serves one folder on loopback; Caddy adds HTTPS and the login. The
# folder belongs to its own system user and has nothing to do with the job
# search. Installed into /etc/caddy/sites/ by notes-password.sh, after the
# login file below exists.
notes-40-160-142-175.sslip.io {
	basic_auth {
		import /etc/caddy/notes-users
	}
	reverse_proxy 127.0.0.1:8780
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}
}
