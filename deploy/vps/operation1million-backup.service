[Unit]
Description=Back up the application decision ledger to GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=operation1million
Group=operation1million
Environment=HOME=/opt/operation1million
EnvironmentFile=/etc/operation1million/env
ExecStart=/opt/operation1million/code/deploy/vps/backup-applications.sh
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/operation1million
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
