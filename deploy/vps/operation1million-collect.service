[Unit]
Description=Operation1million daily collection pass
Documentation=file:/opt/operation1million/code/docs/vps-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=operation1million
Group=operation1million
Environment=HOME=/opt/operation1million
EnvironmentFile=/etc/operation1million/env
ExecStart=/bin/bash /opt/operation1million/bin/daily-pass.sh
# A full-depth pass is about 110 minutes; a sweep day is longer. This is a
# backstop against a hung socket, not a budget the pass is expected to fit.
TimeoutStartSec=10800
Nice=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/operation1million
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
