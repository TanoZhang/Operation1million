[Unit]
Description=Private job application review
After=network.target

[Service]
Type=simple
User=jobdisco
Group=jobdisco
# The same checkout the collector runs from, deliberately. The review queue
# re-applies the hard exclusions at read time -- see applications.py, which
# calls jsearch.load_plan() on every request -- so a second copy of the tree
# means a second copy of the filter, and the queue starts showing what
# collection has already excluded. That is not hypothetical: a hand-made copy
# at /opt/jobdisco/review-code drifted within hours and was serving Boeing,
# RTX and SAIC postings, Senior titles and photonics roles that the collector
# was rejecting at the same moment.
WorkingDirectory=/opt/jobdisco/code
Environment=JOBDISCO_STORE=/opt/jobdisco/data
# Read only: the Gmail replies the timer could not settle.
Environment=JOBDISCO_GMAIL_DIR=/opt/jobdisco/gmail
Environment=PYTHONPATH=/opt/jobdisco/code/src
# The export goes to its own folder: the checkout is read-only here
# (ProtectSystem=strict), and the default under it failed with Errno 30.
ExecStart=/opt/jobdisco/venv/bin/python -m jobdisco.review --db /opt/jobdisco/code/data/db/job_discovery.sqlite --port 8765 --export /opt/jobdisco/exports/review-queue.xlsx
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jobdisco/data/operational /opt/jobdisco/code/data/db /opt/jobdisco/exports

[Install]
WantedBy=multi-user.target
