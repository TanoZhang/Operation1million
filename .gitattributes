# A shell script with CRLF line endings fails on Linux with "bad interpreter",
# and this repository is edited on Windows and executed on a VPS. Pin the ones
# whose line endings are load-bearing rather than relying on core.autocrlf.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
# cmd.exe mislocates goto labels in LF-only batch files.
*.bat text eol=crlf
# Source and documentation stay LF across Windows editors and Linux checkouts.
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
.gitattributes text eol=lf
